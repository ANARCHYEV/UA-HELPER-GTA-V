{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "description": "UA Helper backend: rules sync, voice transcription, Telegram auth, updates",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "sync:run": "tsx src/jobs/run-sync.ts",
    "sync:import": "tsx src/jobs/import-forum-snapshot.ts",
    "gen:latest-yml": "tsx scripts/gen-latest-yml.ts",
    "tg:set-webhook": "tsx scripts/set-webhook.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "better-sqlite3": "13.2.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
