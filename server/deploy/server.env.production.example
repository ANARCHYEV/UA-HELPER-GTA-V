# /opt/ua-helper/server/.env — never commit or copy into the desktop client.
NODE_ENV=production
PORT=3099
HOST=127.0.0.1
DB_PATH=/var/lib/ua-helper/app.db
ALLOWED_ORIGINS=*

TG_BOT_TOKEN=
TG_BOT_USERNAME=gtavhelper_bot
TG_WEBHOOK_SECRET=
TG_UPDATES_MODE=webhook
TELEGRAM_SUBSCRIPTION_CHAT=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://api.gtavhelper.pp.ua/v1/auth/discord/callback
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ROLE_ID=

FORUM_RULES_URL=https://forum.ukraine-gta5.com.ua/forums/%D0%97%D0%B0%D0%B3%D0%B0%D0%BB%D1%8C%D0%BD%D1%96-%D0%BF%D1%80%D0%B0%D0%B2%D0%B8%D0%BB%D0%B0-%D0%BF%D1%80%D0%BE%D1%94%D0%BA%D1%82%D1%83.4/
FORUM_LAWS_URL=https://forum.ukraine-gta5.com.ua/forums/%D0%97%D0%B0%D0%BA%D0%BE%D0%BD%D0%B8.61/
SYNC_ON_START=true
SYNC_CRON=0 */6 * * *
SYNC_RETRY_MINUTES=15,60,180
CRAWLER_DELAY_MS=800

TRANSCRIBE_PROVIDER=local
TRANSCRIBE_LOCAL_URL=http://127.0.0.1:8000
MAX_UPLOAD_MB=10
VOICE_DAILY_LIMIT=200
DOWNLOADS_PUBLIC_URL=https://api.gtavhelper.pp.ua/downloads
ADMIN_TOKEN=
