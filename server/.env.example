# ===== UA Helper API - environment =====
# Copy to .env and fill in real values. Never commit .env.

PORT=3000
# Docker reverse proxies reach this through the internal network. Native VPS
# deployments use HOST=127.0.0.1 in deploy/server.env.production.example.
HOST=0.0.0.0
DB_PATH=/data/app.db
ALLOWED_ORIGINS=*
# DNS A/AAAA record that points to the VPS. Used only by docker-compose.prod.yml.
API_DOMAIN=api.example.org

# --- Telegram login bot (create via @BotFather) ---
# Paste the token only in your local/server .env. Never place it in app.config.json.
TG_BOT_TOKEN=
# Bot username without @, for example ua_helper_auth_bot
TG_BOT_USERNAME=gtavhelper_bot
# Generate a long random value; Telegram sends it back in each webhook request.
TG_WEBHOOK_SECRET=

# --- Discord OAuth + role subscription (optional) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
# A Discord bot token is required only when checking guild membership/roles.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ROLE_ID=
# Telegram channel/group username (@channel) or numeric chat id for subscription checks.
TELEGRAM_SUBSCRIPTION_CHAT=

# --- Forum crawler targets (Ukraine GTA 5 sections) ---
FORUM_RULES_URL=https://forum.ukraine-gta5.com.ua/forums/%D0%97%D0%B0%D0%B3%D0%B0%D0%BB%D1%8C%D0%BD%D1%96-%D0%BF%D1%80%D0%B0%D0%B2%D0%B8%D0%BB%D0%B0-%D0%BF%D1%80%D0%BE%D0%B5%D0%BA%D1%82%D1%83.4/
FORUM_LAWS_URL=https://forum.ukraine-gta5.com.ua/forums/%D0%97%D0%B0%D0%BA%D0%BE%D0%BD%D0%B8.61/
SYNC_ON_START=true
SYNC_CRON=0 */6 * * *
# One-off retries after a temporary network/Cloudflare error; values below 5 minutes are ignored.
SYNC_RETRY_MINUTES=15,60,180
CRAWLER_DELAY_MS=800

# --- Voice transcription ---
# local   = faster-whisper sidecar (docker compose profile "voice")
# external= OpenAI-compatible endpoint
TRANSCRIBE_PROVIDER=local
TRANSCRIBE_LOCAL_URL=http://whisper:8000
TRANSCRIBE_EXTERNAL_URL=
TRANSCRIBE_EXTERNAL_KEY=
MAX_UPLOAD_MB=10
VOICE_DAILY_LIMIT=200

# --- Updates ---
DOWNLOADS_PUBLIC_URL=
# Generate a distinct long random value; required only for /v1/rules/sync and admin status endpoints.
ADMIN_TOKEN=
